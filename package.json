{
  "name": "ai-transform-studio",
  "description": "AI media transformation app — Image-to-Image and Video-to-Video via the Magic Hour API (Next.js App Router)",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "prepare": "lefthook install",
    "test": "vitest run",
    "check:services": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/check-services.ts",
    "webhook:replay": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/webhook-replay.ts",
    "e2e:image": "tsx --env-file-if-exists=.env.local scripts/e2e-image.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "5.9.1",
    "@tanstack/react-query": "5.103.2",
    "@uploadcare/rest-client": "6.22.0",
    "class-variance-authority": "0.7.1",
    "cloudinary": "2.11.0",
    "cn": "0.4.0",
    "lucide-react": "1.47.0",
    "magic-hour": "0.78.0",
    "mongodb": "7.6.0",
    "next": "16.3.4",
    "next-themes": "0.4.6",
    "radix-ui": "1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.88.0",
    "server-only": "0.0.1",
    "sonner": "2.0.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.1.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "lefthook": "2.1.10",
    "shadcn": "4.21.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  },
  "allowScripts": {
    "lefthook@2.1.10": true
  }
}
