# Copy this file to .env.local and fill in real values for local development.
# .env.local is gitignored — never commit real secrets.
#
# Validated by src/lib/env/{server,client}.ts. Checked at server startup by
# src/instrumentation.node.ts: a malformed value always refuses to start; a
# missing value refuses to start in production and only warns in development.
# `next build` needs none of these, except NEXT_PUBLIC_* (see below).

# =============================================================================
# Server-only — never exposed to the browser
# =============================================================================

# MongoDB connection string (mongodb:// or mongodb+srv://), including the database name.
MONGODB_URI=

# Cloudinary cloud name (Dashboard → Product Environment settings).
CLOUDINARY_CLOUD_NAME=

# Cloudinary API key.
CLOUDINARY_API_KEY=

# Cloudinary API secret.
CLOUDINARY_API_SECRET=

# Uploadcare secret key — used server-side to verify/manage uploaded files.
UPLOADCARE_SECRET_KEY=

# Magic Hour API key (Developer → API Keys).
MAGIC_HOUR_API_KEY=

# Secret used to verify incoming Magic Hour webhook requests.
MAGIC_HOUR_WEBHOOK_SECRET=

# This app's public origin, e.g. http://localhost:3000 locally or https://<app>.vercel.app.
# Used to build absolute URLs such as the webhook callback. Normalised to a bare origin.
APP_URL=

# =============================================================================
# Client — inlined into the browser bundle AT BUILD TIME
# =============================================================================

# Uploadcare public key for the client-side upload widget. Must be set when
# `next build` runs (on Vercel: in the project's environment variables).
NEXT_PUBLIC_UPLOADCARE_PUBLIC_KEY=
