# Copy this file to .env.local and fill in real values for local development.
# .env.local is gitignored — never commit real secrets.
#
# Validated by src/lib/env/{server,client}.ts. Checked at server startup by
# src/instrumentation.node.ts: a malformed value always refuses to start; a
# missing value refuses to start in production and only warns in development.
# `next build` needs none of these, except NEXT_PUBLIC_* (see below).

# =============================================================================
# Server-only — never exposed to the browser
# =============================================================================

# MongoDB Atlas connection string (Connect → Drivers), with the database name as
# the path: mongodb+srv://user:pass@cluster.xxxxx.mongodb.net/ai-transform-studio?retryWrites=true&w=majority
# A URI without a database name is rejected rather than writing to `test`.
MONGODB_URI=

# Cloudinary — storage of record for uploads and results (Console → Settings → API Keys).
# Cloud name.
CLOUDINARY_CLOUD_NAME=

# Cloudinary API key.
CLOUDINARY_API_KEY=

# Cloudinary API secret.
CLOUDINARY_API_SECRET=

# Uploadcare secret key (Dashboard → API keys). Server-side only: verifies and
# deletes uploaded files, and signs browser uploads (GET /api/upload/signature),
# which lets the project require "Signed uploads".
UPLOADCARE_SECRET_KEY=

# Magic Hour API key (Developer Hub → API Keys).
MAGIC_HOUR_API_KEY=

# Magic Hour webhook signing secret (Developer Hub → Webhooks, shown when the
# endpoint https://<APP_URL>/api/webhook is created). Verifies every webhook.
MAGIC_HOUR_WEBHOOK_SECRET=

# This app's public origin, e.g. http://localhost:3000 locally or
# https://ai-transform-studio.vercel.app. Normalised to a bare origin. POST
# requests whose Origin header differs are refused (403 FORBIDDEN_ORIGIN).
APP_URL=

# =============================================================================
# Client — inlined into the browser bundle AT BUILD TIME
# =============================================================================

# Uploadcare public key (Dashboard → API keys), used by the browser's direct
# upload. Must be set when `next build` runs (on Vercel: in the project's
# environment variables).
NEXT_PUBLIC_UPLOADCARE_PUBLIC_KEY=
